generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(255)
  code     String    @unique @db.VarChar(32)
  projects Project[]

  @@map("workspaces")
}

model Project {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  name        String    @db.VarChar(255)
  // Also the ticket prefix (e.g. FMS-1), so unique system-wide.
  code        String    @unique @db.VarChar(32)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  defaultRepoId Int? @map("default_repo_id")
  defaultRepo Repo? @relation("DefaultRepo", fields: [defaultRepoId], references: [id], onDelete: SetNull)
  // legacy slug, read only by AgentImportService; drop after import
  specAgent String? @map("spec_agent") @db.VarChar(128)
  devAgent String? @map("dev_agent") @db.VarChar(128)
  testAgent String? @map("test_agent") @db.VarChar(128)
  specAgentId Int? @map("spec_agent_id")
  devAgentId Int? @map("dev_agent_id")
  testAgentId Int? @map("test_agent_id")
  specAgentRef Agent? @relation("ProjectSpecAgent", fields: [specAgentId], references: [id], onDelete: SetNull)
  devAgentRef Agent? @relation("ProjectDevAgent", fields: [devAgentId], references: [id], onDelete: SetNull)
  testAgentRef Agent? @relation("ProjectTestAgent", fields: [testAgentId], references: [id], onDelete: SetNull)
  repos Repo[] @relation("ProjectRepos")
  tickets Ticket[]
  specSource SpecSource @default(JIRA) @map("spec_source")
  specDir String? @map("spec_dir") @db.VarChar(1024)
  localTicketSeq Int @default(0) @map("local_ticket_seq")
  sprints Sprint[]

  @@index([workspaceId])
  @@map("projects")
}

enum SpecSource {
  LOCAL
  JIRA
  HYBRID
}

enum TicketSource {
  JIRA
  LOCAL
}

enum SprintSource {
  JIRA
  LOCAL
}

enum SprintState {
  FUTURE
  ACTIVE
  CLOSED
}

// One ACTIVE LOCAL sprint per project: partial unique index in migration SQL.
model Sprint {
  id Int @id @default(autoincrement())
  source SprintSource
  jiraSprintId Int? @unique @map("jira_sprint_id")
  jiraBoardId Int? @map("jira_board_id")
  projectId Int? @map("project_id")
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name String @db.VarChar(255)
  state SprintState @default(FUTURE)
  startDate DateTime? @map("start_date")
  endDate DateTime? @map("end_date")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  tickets Ticket[]

  @@index([projectId])
  @@map("sprints")
}

enum TicketStatus {
  TODO
  IN_SPEC
  IN_REVIEW_SPEC
  IN_PROGRESS
  IN_TESTING
  IN_REVIEW
  DONE
  CANCELED
}

enum AgentRole {
  BA
  DEV
  QC
  FILE_PROCESSOR
}
enum BranchKind {
  CHECKOUT_BASE
  PR_TARGET
  NONE
}

model Repo {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(64)
  path String @unique @db.VarChar(1024)
  description String @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  environments RepoEnvironment[]
  projects Project[] @relation("ProjectRepos")
  defaultFor Project[] @relation("DefaultRepo")
  tickets Ticket[]
  scheduledTasks ScheduledTaskRepo[]
  @@map("repos")
}

model RepoEnvironment {
  id Int @id @default(autoincrement())
  repoId Int @map("repo_id")
  name String @db.VarChar(64)
  envFile String @default("") @map("env_file") @db.VarChar(255)
  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  branches RepoBranch[]
  @@unique([repoId, name])
  @@map("repo_environments")
}

// One CHECKOUT_BASE per repo: partial unique index in migration SQL; repoId is denormalized for it.
model RepoBranch {
  id Int @id @default(autoincrement())
  environmentId Int @map("environment_id")
  repoId Int @map("repo_id")
  name String @db.VarChar(255)
  kind BranchKind @default(NONE)
  environment RepoEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  @@unique([environmentId, name])
  @@map("repo_branches")
}

model Agent {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(128)
  role AgentRole
  provider String @db.VarChar(16)
  model String? @db.VarChar(128)
  effort String? @db.VarChar(32)
  path String @db.VarChar(1024)
  description String @default("") @db.VarChar(512)
  allowedTools String[] @default([]) @map("allowed_tools")
  skills Skill[]
  rules Rule[]
  projectsAsSpec Project[] @relation("ProjectSpecAgent")
  projectsAsDev Project[] @relation("ProjectDevAgent")
  projectsAsTest Project[] @relation("ProjectTestAgent")
  ticketsAsSpec Ticket[] @relation("TicketSpecAgent")
  ticketsAsDev Ticket[] @relation("TicketDevAgent")
  ticketsAsTest Ticket[] @relation("TicketTestAgent")
  runs AgentRun[]
  scheduledTasks ScheduledTask[]
  scheduledRuns ScheduledRun[] @relation("ScheduledRunAgent")
  @@map("agents")
}

model Skill {
  id Int @id @default(autoincrement())
  name String @db.VarChar(128)
  provider String @db.VarChar(16)
  command String @db.VarChar(128)
  path String @db.VarChar(1024)
  description String @default("") @db.Text
  agents Agent[]
  tickets Ticket[]
  @@unique([provider, name])
  @@map("skills")
}

model Rule {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(128)
  path String @db.VarChar(1024)
  description String @default("") @db.Text
  agents Agent[]
  tickets Ticket[]
  @@map("rules")
}

model Ticket {
  id Int @id @default(autoincrement())
  // Ticket key for any source (Jira key or <CODE>-L<n>).
  jiraKey String @unique @map("jira_key") @db.VarChar(64)
  source TicketSource @default(JIRA)
  specFile String? @map("spec_file") @db.VarChar(1024)
  sprintId Int? @map("sprint_id")
  sprint Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  summary String @db.VarChar(1024)
  description String @db.Text
  issueType String @map("issue_type") @db.VarChar(64)
  jiraStatus String @map("jira_status") @db.VarChar(128)
  jiraUrl String @map("jira_url") @db.VarChar(1024)
  // Direct Jira parent (one level), refreshed on every sync.
  parentKey String? @map("parent_key") @db.VarChar(64)
  parentSummary String? @map("parent_summary") @db.VarChar(1024)
  parentDescription String? @map("parent_description") @db.Text
  status TicketStatus @default(TODO)
  projectId Int? @map("project_id")
  repoId Int? @map("repo_id")
  // legacy slugs/extraSkills, read only by AgentImportService; drop after import
  specAgent String? @map("spec_agent") @db.VarChar(128)
  devAgent String? @map("dev_agent") @db.VarChar(128)
  testAgent String? @map("test_agent") @db.VarChar(128)
  specAgentId Int? @map("spec_agent_id")
  devAgentId Int? @map("dev_agent_id")
  testAgentId Int? @map("test_agent_id")
  specAgentRef Agent? @relation("TicketSpecAgent", fields: [specAgentId], references: [id], onDelete: SetNull)
  devAgentRef Agent? @relation("TicketDevAgent", fields: [devAgentId], references: [id], onDelete: SetNull)
  testAgentRef Agent? @relation("TicketTestAgent", fields: [testAgentId], references: [id], onDelete: SetNull)
  skills Skill[]
  rules Rule[]
  branch String? @db.VarChar(255)
  linkedAt DateTime? @map("linked_at")
  specApprovedAt DateTime? @map("spec_approved_at")
  extraInstructions String @default("") @map("extra_instructions") @db.Text
  extraSkills String[] @default([]) @map("extra_skills")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  repo Repo? @relation(fields: [repoId], references: [id], onDelete: SetNull)
  runs AgentRun[]
  specs SpecVersion[]
  fixRound Int @default(0) @map("fix_round")
  testCases TestCase[]
  @@index([sprintId])
  @@index([projectId])
  @@map("tickets")
}

enum AgentStep {
  SPEC
  DEV
  TEST
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  STOPPED
}

// Partial unique index is defined in migration 20261031100617_running_run_unique.
model AgentRun {
  id Int @id @default(autoincrement())
  ticketId Int @map("ticket_id")
  step AgentStep
  testMode TestMode? @map("test_mode")
  results TestResult[]
  // Agent name at run time, kept for history.
  agentSlug String @map("agent_slug") @db.VarChar(128)
  agentId Int? @map("agent_id")
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  paneId String? @map("pane_id") @db.VarChar(128)
  token String @db.VarChar(64)
  status AgentRunStatus @default(RUNNING)
  // Feedback sent when this run started; copied onto the spec version it produces.
  feedback String? @db.Text
  error String? @db.Text
  startedAt DateTime @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, step])
  @@map("agent_runs")
}

enum ScheduledRunStatus {
  RUNNING
  COMPLETED
  FAILED
  STOPPED
  MISSED
  SKIPPED
}

enum ScheduledRunTrigger {
  SCHEDULE
  MANUAL
  RERUN
}

model ScheduledTask {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(128)
  slug String @unique @db.VarChar(128)
  prompt String @db.Text
  enabled Boolean @default(true)
  time Int
  days Int[]
  agentId Int @map("agent_id")
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Restrict)
  repos ScheduledTaskRepo[]
  outputDir String @map("output_dir") @db.VarChar(1024)
  checkedUntil DateTime @default(now()) @map("checked_until")
  runs ScheduledRun[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("scheduled_tasks")
}

model ScheduledTaskRepo {
  taskId Int @map("task_id")
  repoId Int @map("repo_id")
  position Int
  task ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo Repo @relation(fields: [repoId], references: [id], onDelete: Restrict)
  @@id([taskId, repoId])
  @@unique([taskId, position])
  @@map("scheduled_task_repos")
}

// Partial unique indexes are defined in migration 20261104004250_scheduled_tasks.
model ScheduledRun {
  id Int @id @default(autoincrement())
  taskId Int @map("task_id")
  task ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  scheduledFor DateTime @map("scheduled_for")
  trigger ScheduledRunTrigger
  status ScheduledRunStatus
  rerunOfId Int? @unique @map("rerun_of_id")
  rerunOf ScheduledRun? @relation("ScheduledRerun", fields: [rerunOfId], references: [id], onDelete: SetNull)
  rerun ScheduledRun? @relation("ScheduledRerun")
  dismissedAt DateTime? @map("dismissed_at")
  agentId Int? @map("agent_id")
  agent Agent? @relation("ScheduledRunAgent", fields: [agentId], references: [id], onDelete: SetNull)
  agentName String @map("agent_name") @db.VarChar(128)
  paneId String? @map("pane_id") @db.VarChar(128)
  token String @db.VarChar(64)
  outputPath String? @map("output_path") @db.VarChar(1024)
  output String? @db.Text
  error String? @db.Text
  startedAt DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([taskId, scheduledFor])
  @@map("scheduled_runs")
}

model SpecVersion {
  id Int @id @default(autoincrement())
  ticketId Int @map("ticket_id")
  version Int
  content String @db.Text
  feedback String? @db.Text
  editedAt DateTime? @map("edited_at")
  createdAt DateTime @default(now()) @map("created_at")
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@unique([ticketId, version])
  @@map("spec_versions")
}

enum TestMode {
  WRITE_CASES
  RUN_CASES
}

model TestCase {
  id Int @id @default(autoincrement())
  ticketId Int @map("ticket_id")
  position Int
  title String @db.VarChar(512)
  steps String @db.Text
  expected String @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  results TestResult[]
  @@unique([ticketId, position])
  @@map("test_cases")
}

model TestResult {
  id Int @id @default(autoincrement())
  agentRunId Int @map("agent_run_id")
  testCaseId Int @map("test_case_id")
  passed Boolean
  detail String @default("") @db.Text
  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  @@unique([agentRunId, testCaseId])
  @@map("test_results")
}
