generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(255)
  code     String    @unique @db.VarChar(32)
  projects Project[]

  @@map("workspaces")
}

model Project {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  name        String    @db.VarChar(255)
  // Also the ticket prefix (e.g. FMS-1), so unique system-wide.
  code        String    @unique @db.VarChar(32)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  defaultRepoId Int? @map("default_repo_id")
  defaultRepo ProjectRepo? @relation("DefaultRepo", fields: [defaultRepoId], references: [id], onDelete: SetNull)
  specAgent String? @map("spec_agent") @db.VarChar(128)
  devAgent String? @map("dev_agent") @db.VarChar(128)
  testAgent String? @map("test_agent") @db.VarChar(128)
  repos ProjectRepo[] @relation("ProjectRepos")
  tickets Ticket[]

  @@index([workspaceId])
  @@map("projects")
}

enum TicketStatus {
  TODO
  IN_SPEC
  IN_REVIEW_SPEC
  IN_PROGRESS
  IN_TESTING
  IN_REVIEW
  DONE
  CANCELED
}

model ProjectRepo {
  id Int @id @default(autoincrement())
  projectId Int @map("project_id")
  name String @db.VarChar(64)
  path String @db.VarChar(1024)
  project Project @relation("ProjectRepos", fields: [projectId], references: [id], onDelete: Cascade)
  defaultFor Project[] @relation("DefaultRepo")
  tickets Ticket[]
  @@unique([projectId, name])
  @@map("project_repos")
}

model Ticket {
  id Int @id @default(autoincrement())
  jiraKey String @unique @map("jira_key") @db.VarChar(64)
  summary String @db.VarChar(1024)
  description String @db.Text
  issueType String @map("issue_type") @db.VarChar(64)
  jiraStatus String @map("jira_status") @db.VarChar(128)
  jiraUrl String @map("jira_url") @db.VarChar(1024)
  status TicketStatus @default(TODO)
  projectId Int? @map("project_id")
  repoId Int? @map("repo_id")
  specAgent String? @map("spec_agent") @db.VarChar(128)
  devAgent String? @map("dev_agent") @db.VarChar(128)
  testAgent String? @map("test_agent") @db.VarChar(128)
  linkedAt DateTime? @map("linked_at")
  specApprovedAt DateTime? @map("spec_approved_at")
  extraInstructions String @default("") @map("extra_instructions") @db.Text
  extraSkills String[] @default([]) @map("extra_skills")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  repo ProjectRepo? @relation(fields: [repoId], references: [id], onDelete: SetNull)
  runs AgentRun[]
  specs SpecVersion[]
  @@index([projectId])
  @@map("tickets")
}

enum AgentStep {
  SPEC
  DEV
  TEST
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  STOPPED
}

model AgentRun {
  id Int @id @default(autoincrement())
  ticketId Int @map("ticket_id")
  step AgentStep
  agentSlug String @map("agent_slug") @db.VarChar(128)
  paneId String? @map("pane_id") @db.VarChar(128)
  token String @db.VarChar(64)
  status AgentRunStatus @default(RUNNING)
  // Feedback sent when this run started; copied onto the spec version it produces.
  feedback String? @db.Text
  error String? @db.Text
  startedAt DateTime @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, step])
  @@map("agent_runs")
}

model SpecVersion {
  id Int @id @default(autoincrement())
  ticketId Int @map("ticket_id")
  version Int
  content String @db.Text
  feedback String? @db.Text
  editedAt DateTime? @map("edited_at")
  createdAt DateTime @default(now()) @map("created_at")
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@unique([ticketId, version])
  @@map("spec_versions")
}
