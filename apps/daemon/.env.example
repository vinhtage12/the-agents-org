DATABASE_URL=postgresql://agent_org:agent_org@localhost:5432/agent_org?schema=public
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Optional. Defaults to ~/.config/herdr/herdr.sock on Unix-like systems.
# On Windows, set this to Herdr's named-pipe path.
HERDR_SOCKET_PATH=~/.config/herdr/herdr.sock
# Set when the Herdr executable is not available on PATH.
HERDR_BIN_PATH=/home/vinhtage/.local/bin/herdr

# Optional agent profiles directory (default: ~/.the-agents-org/agents)
# AGENTS_DIR=

# Optional Jira Cloud credentials; Sync returns 503 when absent
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
